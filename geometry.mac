# This macro is where you specifiy a CAD model, set material properties, 
# and adjust palcement of CAD model (light guide) and photon sensor (PMT)


# ----- Set world size. Must be large enough to contain CAD model. -----
/papas/worldVolume 0.25 0.25 0.25 m
/papas/envelope 89.75 113. 165. mm

# ----- Set PMT size -----
# Default PMT window is circular
/papas/model/PMTDiameter 50 mm
/papas/model/nSegmentsX 1
/papas/model/nSegmentsZ 1



#----- Set the light guide to be used and position it -----
# The desired CAD model must be an ASCII STL, and should be deopsited in the "models folder".
# If no model is selected, the program will default to a
# simplified version of the 2018 testbeam light guide.
# The four example models listed below are found in the 'models' folder

/papas/model/CADmodel ../models/run2.stl
/papas/model/translate 200 -125 0 mm
/papas/model/translatePMT 0 -74.5 0 mm

#/papas/model/CADmodel ../models/EMprototype.stl
#/papas/model/translate 0 0 0 mm
#/papas/model/translatePMT 0 -74.5 0 mm

#/papas/model/CADmodel ../models/EMprototypeSingle.stl
#/papas/model/translate 175.25 -27.75 -8 mm
