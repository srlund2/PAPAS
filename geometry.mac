#----- Set surface properties of the light guide -----
#/papas/surface/Model unified
#/papas/surface/Type dielectric_metal
#/papas/surface/Finish ground
#/papas/surface/SigmaAlpha .1
#/papas/surface/Property SPECULARLOBECONSTANT 0.000002 .4 0.000008 .4
#/papas/surface/Property SPECULARSPIKECONSTANT 0.000002 .1 0.000008 .1
#/papas/surface/Property BACKSCATTERCONSTANT 0.000002 .05 0.000008 .05
#/papas/surface/Property REFLECTIVITY 0.000002 .89 0.000008 .89


#----- Set the refractive index of the gas the light guide is inside of -----
#/papas/gasProperty RINDEX 0.000002 1.0 0.000008 1.0
